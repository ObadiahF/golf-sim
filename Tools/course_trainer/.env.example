# Copy to .env (next to docker-compose.yml) and edit. Never commit .env.

# Postgres password (the db container is created with it on first start; changing it later needs ALTER USER).
POSTGRES_PASSWORD=change-me-db
# Or point at another Postgres instead of the bundled one:
# TRAINER_DATABASE_URL=postgresql://trainer:pw@host:5432/trainer

# Signs the login cookies. Long and random: `openssl rand -base64 32`. Changing it logs everyone out.
TRAINER_SESSION_SECRET=

# Public URL: https://golf-trainer.obadiahfusco.xyz (Cloudflare Tunnel -> http://localhost:8765).
# TLS ends at Cloudflare, so cookies must be Secure. Set false only for plain http://host:8765 testing on the LAN.
TRAINER_COOKIE_SECURE=true
TRAINER_SESSION_DAYS=30
# Behind the tunnel every request comes from cloudflared: take the visitor's IP from CF-Connecting-IP
# (else X-Forwarded-For) for the login throttle. Only enable when the port is reachable through the proxy alone.
TRAINER_TRUST_PROXY=true

# Published port on the host and the interface it binds. 127.0.0.1: only cloudflared on this host can reach it
# (keeps the trusted proxy headers unforgeable). Use 0.0.0.0 if cloudflared runs on another machine.
TRAINER_PORT=8765
TRAINER_BIND=127.0.0.1

# Created on startup if missing (existing users keep their password; use `passwd`). name:password, comma-separated.
TRAINER_SEED_USERS=obi:changeme

# Generation: concurrent generations (pool worker processes + ad-hoc Generate; others queue), unrated holes kept,
# hours a viewed hole is protected. The R730xd (24+ cores) runs 8.
TRAINER_MAX_GENERATIONS=8
TRAINER_KEEP_UNRATED=40
TRAINER_VIEW_GRACE_HOURS=3

# Shared hole pool: holes per batch, and the share of the newest batch anyone has seen that starts the next one.
TRAINER_POOL_BATCH_SIZE=100
TRAINER_POOL_REFILL_AT=0.5

# Read-only key for the Unity game (/api/game/*: top holes + package files). Generate: `openssl rand -hex 24`.
# Empty: the game API is off (404).
TRAINER_GAME_KEY=
