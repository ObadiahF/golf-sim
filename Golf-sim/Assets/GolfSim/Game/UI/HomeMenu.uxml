<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Menu.uss" />
    <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1;">
        <ui:Label text="Esc  Menu" class="home-hint" picking-mode="Ignore" />
        <ui:VisualElement name="home" class="home">
            <ui:VisualElement class="home__panel">
                <ui:Label text="Paused" class="home__title" />
                <ui:Label text="Back: resume  ·  Up/Down, Select: choose" class="home__subtitle" />
                <ui:VisualElement class="room room--panel">
                    <ui:Label name="room-code" class="room__code" />
                    <ui:Label name="room-status" class="room__status" />
                </ui:VisualElement>
                <ui:Button name="home-resume" text="Resume" class="btn btn--primary" />
                <ui:Button name="home-restart" text="Restart Hole" class="btn btn--ghost" />
                <ui:Button name="home-sound" text="Sound" class="btn btn--ghost" />
                <ui:Button name="home-menu" text="Main Menu" class="btn btn--ghost" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
