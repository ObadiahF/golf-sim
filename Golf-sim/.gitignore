# Course pipeline: raw downloads are large, keep them out of git
/CourseSources/**/*.tif
/CourseSources/**/*.tiff
/CourseSources/**/*.laz
/CourseSources/**/*.las
/Tools/**/.venv/
__pycache__/

# Third-party Asset Store content (large, licensed): re-extract instead of committing
/Assets/TerrainDemoScene_URP/
/Assets/TerrainDemoScene_URP.meta
/Assets/VegetationSpawner/
/Assets/VegetationSpawner.meta
/Assets/PinwheelStudio/
/Assets/PinwheelStudio.meta
/Assets/Visual Design Cafe/
/Assets/Visual Design Cafe.meta
/Assets/WebGpuWater/
/Assets/WebGpuWater.meta
/Packages/com.abstractocclusion.webgpuwater/
/Assets/Temp/
/Assets/Temp.meta

# Generated by Golf > Course Builder (rebuild with Generate Hole); hole.json + heightmap.raw are the source
/Assets/CourseData/**/TerrainData.asset
/Assets/CourseData/**/TerrainData.asset.meta
/Assets/CourseData/**/Water*.asset
/Assets/CourseData/**/Water*.asset.meta
/Assets/CourseData/**/Cup*.asset
/Assets/CourseData/**/Cup*.asset.meta

# Claude Code agent worktrees
/.claude/
/Packages/com.vdc.nature-renderer.free.uas.json

# Course generator: generated holes are disposable (ratings keep their parameters); model is derived
/Assets/CourseData/generated/
/Assets/CourseData/generated.meta
/Tools/course_gen/data/preference_model.npz
.pytest_cache/

# Playwright MCP scratch (screenshots, snapshots)
/.playwright-mcp/

# Course Trainer game key for the sim (secret)
/Assets/GolfSim/Net/Resources/TrainerKey.txt
/Assets/GolfSim/Net/Resources/TrainerKey.txt.meta
# Game server token for the sim (secret)
/Assets/GolfSim/Net/Resources/ServerToken.txt
